# 00277 — Hostinger/Apache: SPA fallback + caching for Vite build (copied into dist/ by `npm run build`)
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  # Hashed assets are immutable; HTML and the service worker must always revalidate
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
