# ═══ إلزامية (يفحصها scripts/check-env.ts قبل كل build) ═══
# رابط المشروع: Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح الواجهة — الصيغة الجديدة: sb_publishable_... (بديل anon القديم)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ═══ اختيارية ═══
# بيئة التشغيل: development | staging | production
VITE_APP_ENV=development
# Sentry — يُفعَّل فقط عند وجود DSN
VITE_SENTRY_DSN=

# ═══ الخادم فقط (بلا VITE_ — لا يُضمَّن في المتصفح) ═══
# مفتاح سري: sb_secret_... (بديل service_role) — للاختبارات التكاملية والسكربتات
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ═══ تطبيق المهاجرات من الترمينال (npm run db:push) ═══
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx   (Account → Access Tokens)
# SUPABASE_PROJECT_REF=YOUR-PROJECT-REF        (من رابط المشروع)
# SUPABASE_DB_PASSWORD=********                (كلمة مرور قاعدة البيانات)
