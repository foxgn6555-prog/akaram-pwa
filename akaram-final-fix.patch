@@ -0,0 +1,49 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { renderHook, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { hrKeys } from '@lib/query-keys/hr.keys'
+import { useHrHireRequests } from '@features/hr/hooks/useHr'
+
+const mocks = vi.hoisted(() => ({
+  session: null as null | { id: string; email: string | null; fullName: string | null; primaryRole: string; roles: string[] },
+  hireRequests: vi.fn(async () => []),
+}))
+
+vi.mock('@features/auth/hooks/useAuth', () => ({
+  useAuth: () => ({ data: mocks.session, isLoading: false }),
+}))
+vi.mock('@sdk/hr.sdk', () => ({
+  hr: { hireRequests: mocks.hireRequests },
+  hrErrorMessage: () => 'HR error',
+}))
+
+function makeWrapper() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  const wrapper = ({ children }: { children: React.ReactNode }) => <QueryClientProvider client={client}>{children}</QueryClientProvider>
+  return { client, wrapper }
+}
+
+describe('HR visual preview request isolation', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    mocks.session = { id: 'it-user', email: null, fullName: null, primaryRole: 'it_admin', roles: ['it_admin'] }
+  })
+
+  it('skips the protected HR RPC and hides cached hire requests for IT preview', () => {
+    const { client, wrapper } = makeWrapper()
+    client.setQueryData([...hrKeys.hireRequests('approved'), 'it-preview'], [{ id: 'private-hire-request' }])
+
+    const { result } = renderHook(() => useHrHireRequests('approved'), { wrapper })
+
+    expect(result.current.data).toEqual([])
+    expect(mocks.hireRequests).not.toHaveBeenCalled()
+  })
+
+  it('keeps the request list available to HR', async () => {
+    mocks.session = { id: 'hr-user', email: null, fullName: null, primaryRole: 'hr_officer', roles: ['hr_officer'] }
+    const { wrapper } = makeWrapper()
+    renderHook(() => useHrHireRequests('approved'), { wrapper })
+
+    await waitFor(() => expect(mocks.hireRequests).toHaveBeenCalledTimes(1))
+  })
+})
