{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@sdk/*": [
        "src/services/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@features/*": [
        "src/features/*"
      ],
      "@portals/*": [
        "src/portals/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@stores/*": [
        "src/stores/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@i18n/*": [
        "src/i18n/*"
      ],
      "@router/*": [
        "src/router/*"
      ]
    }
  }
}