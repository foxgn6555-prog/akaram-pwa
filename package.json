{
  "name": "municipal-pwa",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "نظام إدارة شركة البلدية — PWA داخلي (شركة واحدة) · Feature-Driven Architecture",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "db:seed": "bash scripts/seed-local.sh",
    "feature:new": "bash scripts/scaffold-feature.sh",
    "db:push": "node scripts/db-push.mjs",
    "secrets:check": "bash scripts/check-secrets.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "role:set": "node scripts/set-role.mjs",
    "user:create": "node scripts/create-user.mjs",
    "user:reset-pass": "node scripts/reset-password.mjs",
    "functions:deploy": "bash scripts/deploy-functions.sh",
    "simulate": "bash scripts/simulate-devices.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.0",
    "@sentry/react": "^9.30.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.80.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^25.2.0",
    "lucide-react": "^1.35.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^15.5.0",
    "react-router": "^7.6.0",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  }
}
