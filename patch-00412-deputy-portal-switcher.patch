-/** كل البوابات التي يملك المستخدم صلاحية الدخول إليها بحسب أدواره */
-export function accessiblePortals(roles: readonly string[]): PortalDefinition[] {
-  // مدير النظام (super_admin) يصل لكل البوابات — يراها كلها في المبدّل
